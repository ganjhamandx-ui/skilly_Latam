DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.2

POSTGRES_DB=skilly
POSTGRES_USER=skilly_app
POSTGRES_PASSWORD=CAMBIAR_POR_LA_CONTRASENA_LOCAL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SCHEMA=skilly

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=skilly_documental

FRONTEND_ORIGIN=http://127.0.0.2:57744
RECUPERACION_MINUTOS=10

# Limites temporales: intentos/segundos, varias ventanas separadas por coma.
ACCESO_LOGIN_IP=30/60,300/3600
ACCESO_LOGIN_IDENTIDAD_IP=8/60,40/3600
ACCESO_RECUPERAR_IP=8/600,40/3600
ACCESO_RECUPERAR_IDENTIDAD_IP=3/600,10/3600
ACCESO_RESTABLECER_IP=20/300,100/3600
ACCESO_RESTABLECER_IDENTIDAD_IP=8/300,20/3600
# LocMem solo protege un proceso local. Configurar cache atomica compartida
# para varios trabajadores; no guardar credenciales de cache en Git.
ACCESO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
ACCESO_CACHE_LOCATION=skilly-acceso-local
# CIDRs de proxies realmente controlados; vacio ignora X-Forwarded-For.
ACCESO_PROXIES_CONFIABLES=
